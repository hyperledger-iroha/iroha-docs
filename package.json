{
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "@messageformat/runtime": "3.0.2",
      "ajv@6": "6.14.0",
      "axios": "1.18.1",
      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.3",
      "brace-expansion@5": "5.0.9",
      "defu": "6.1.7",
      "diff@5": "5.2.2",
      "flatted": "3.4.4",
      "form-data": "4.0.6",
      "glob@10": "10.5.0",
      "immutable@4": "4.3.9",
      "immutable@5": "5.1.9",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "mdast-util-to-hast": "13.2.1",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "picomatch@2": "2.3.2",
      "postcss": "8.5.25",
      "preact": "10.29.7",
      "rollup": "4.59.0",
      "svgo": "3.3.4",
      "uuid@9.0.0": "11.1.1",
      "vite": "6.4.3"
    }
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vitepress build",
    "serve": "vitepress serve",
    "format": "prettier-eslint --include-dot-files \"**/*.{js,ts,mts,vue,json}\"",
    "format:check": "pnpm format --list-different",
    "format:fix": "pnpm format --write",
    "lint": "eslint --ext .js,.ts,.mts,.vue . .vitepress",
    "typecheck": "tsc --noEmit",
    "refresh:iroha": "tsx etc/refresh-iroha.ts",
    "translate": "tsx etc/translate.ts",
    "validate:content": "tsx etc/validate-content-policy.ts",
    "validate:i18n": "tsx etc/validate-i18n.ts",
    "validate:provenance": "tsx etc/validate-provenance.ts",
    "validate": "pnpm validate:content && pnpm validate:i18n && pnpm validate:provenance",
    "test": "VITE_CJS_IGNORE_WARNING=true vitest run",
    "cli": "tsx etc/cli"
  },
  "devDependencies": {
    "@mdit-vue/shared": "^3.0.2",
    "@mdit/plugin-katex": "^1.0.2",
    "@scale-codec/definition-compiler": "^4.0.1",
    "@types/debug": "^4.1.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.34",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@unocss/transformer-directives": "^0.65.4",
    "case": "^1.6.3",
    "chalk": "^4",
    "css-select": "^5.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.30.0",
    "fast-diff": "^1.3.0",
    "globby": "^13.2.2",
    "hasha": "^5.2.2",
    "htmlparser2": "^9.0.0",
    "leven": "^4.0.0",
    "markdown-it": "^14.2.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^10.9.6",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "prettier-eslint-cli": "^8.0.1",
    "sass": "^1.93.2",
    "ts-pattern": "^5.9.0",
    "tsx": "^4.20.6",
    "typescript": "5.6.3",
    "unocss": "^0.65.4",
    "vite": "^6.4.3",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "1.6.4",
    "vitest": "^3.2.6",
    "yargs": "^17.6.2"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@vue-kakuyaku/core": "^0.4.3",
    "@vueuse/core": "^12.8.2",
    "@vueuse/math": "^12.8.2",
    "mande": "^2.0.9",
    "rapidoc": "^9.3.8",
    "tiny-invariant": "^1.3.3",
    "vue": "^3.5.22"
  }
}
